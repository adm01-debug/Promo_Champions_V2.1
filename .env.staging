# Staging Environment Configuration
NODE_ENV=staging

# Supabase (Staging)
VITE_SUPABASE_URL=https://staging.supabase.co
VITE_SUPABASE_ANON_KEY=staging-key-here

# API URLs
VITE_API_URL=https://api-staging.salespro.com
VITE_APP_URL=https://staging.salespro.com

# Features Flags (Staging)
VITE_ENABLE_BETA_FEATURES=true
VITE_ENABLE_DEBUG=true

# Integrations (Staging)
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=

# Email (Staging - SendGrid)
SENDGRID_API_KEY=staging-key
SENDGRID_FROM_EMAIL=staging@salespro.com
