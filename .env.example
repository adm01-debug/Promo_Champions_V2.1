# =============================================================================
# PROMO CHAMPIONS - Environment Variables
# =============================================================================
# Somente variáveis realmente lidas pelo código (src/ e vite.config.ts).
# Vars de edge functions ficam nos Secrets do Supabase — ver docs/DEPLOYMENT.md.

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Projeto canônico: usyxfpqlsspldubptrdl
# Get these values from: https://supabase.com/dashboard/project/usyxfpqlsspldubptrdl/settings/api
VITE_SUPABASE_URL=https://usyxfpqlsspldubptrdl.supabase.co
# Preferred name (client.ts reads this first):
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
# Legacy alias (still accepted as fallback in client.ts):
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Error tracking (OPTIONAL)
# -----------------------------------------------------------------------------
# Sentry — carregado sob demanda só quando VITE_SENTRY_DSN existe
# (src/lib/errorTracking.ts):
# VITE_SENTRY_DSN=
# Source maps no build (plugin @sentry/vite-plugin, opcional — sem token o
# build segue normal e os .map ficam locais):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# =============================================================================
# Setup Instructions:
# 1. Copy this file to .env
# 2. Fill in the REQUIRED variables
# 3. Restart dev server: npm run dev
#
# Nota: feature flags NÃO são env vars — ficam no banco e são gerenciadas em
# /admin (FeatureFlagsAdmin / useFeatureFlags).
# =============================================================================
