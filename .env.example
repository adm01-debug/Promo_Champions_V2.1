# =============================================================================
# SALESPRO - Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Request timeout in milliseconds (default: 30000 = 30s). Prevents slow-query DoS.
VITE_SUPABASE_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Application Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# API URL (if using external API)
# VITE_API_URL=https://api.yourapp.com

# App Environment
# VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Feature Flags (OPTIONAL)
# -----------------------------------------------------------------------------
# Enable/disable features
# VITE_FEATURE_AI_COACHING=true
# VITE_FEATURE_GAMIFICATION=true
# VITE_FEATURE_ANALYTICS=true

# -----------------------------------------------------------------------------
# Third-Party Integrations (OPTIONAL)
# -----------------------------------------------------------------------------
# Sentry for error tracking
# VITE_SENTRY_DSN=

# Analytics
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://app.posthog.com

# Email (Resend) — from address must be a verified domain in Resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_ADDRESS=Your App <noreply@yourdomain.com>
# BROADCAST_EMAIL_DELAY_MS=0  # delay between batch emails (0 = disabled)

# -----------------------------------------------------------------------------
# Development Tools (OPTIONAL)
# -----------------------------------------------------------------------------
# Debug mode
# VITE_DEBUG=false

# Mock data
# VITE_USE_MOCK_DATA=false

# =============================================================================
# Setup Instructions:
# 1. Copy this file to .env
# 2. Fill in the REQUIRED variables
# 3. Restart dev server: npm run dev
# =============================================================================
