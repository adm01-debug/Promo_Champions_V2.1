#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Type check
echo "📝 Type checking..."
npm run type-check

# Lint
echo "🔍 Linting..."
npm run lint

# Format check
echo "💅 Format checking..."
npm run format:check

# Tests
echo "🧪 Running tests..."
npm test -- --run

echo "✅ Pre-commit checks passed!"
