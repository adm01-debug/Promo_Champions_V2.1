{
  "tasks": {
    "check": "deno check supabase/functions/*/index.ts supabase/functions/_shared/*.ts",
    "test:migrations": "deno test --allow-read tests/migrations/",
    "lint:functions": "deno lint"
  },
  "lint": {
    "include": ["supabase/functions"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["require-await"]
    }
  },
  "fmt": {
    "include": ["supabase/functions"]
  }
}
