// Compilação estrita incremental (ver docs/TYPE_DEBT.md e
// scripts/check-typecheck-strict.mjs): ativa flags ainda não zeradas e compara
// os erros contra scripts/typecheck-strict-baseline.json — o CI reprova apenas
// erros NOVOS. Zerou a baseline? MovA a flag para tsconfig.app.json.
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
